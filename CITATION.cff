cff-version: 1.2.0
message: "If you use ImagoKit in published work, please cite it as below."
title: "ImagoKit"
type: software
abstract: >-
  Image analysis for electron micrographs in Swift: the calibrated FFT, radial profile, lattice spacings and angles from
  FFT spots, Bragg and HRTEM filtering, drift and stack alignment, thresholding, morphology, segmentation, denoising,
  resampling and GPA strain, checked against NumPy, SciPy and scikit-image.
authors:
  - family-names: Lobpreis
    given-names: Paul
license: GPL-3.0-only
version: 0.8.0 # x-release-please-version
date-released: 2026-10-22
repository-code: "https://github.com/mac4DSTEM/ImagoKit"
keywords:
  - electron microscopy
  - image analysis
  - FFT
  - Swift
references:
  - type: software
    title: "scikit-image"
    authors:
      - name: "The scikit-image developers"
    repository-code: "https://github.com/scikit-image/scikit-image"
    notes: "The reference implementation ImagoKit's filters and alignment are checked against, with NumPy and SciPy."
